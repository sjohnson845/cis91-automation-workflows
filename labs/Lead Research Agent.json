      "id": "553c84d3-5548-4aeb-82c2-e38932d78204",
      "name": "Compile Report"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst data = $input.item.json;\n\nconst report = `\n========================================\nLEAD RESEARCH REPORT\n========================================\n\nCompany: ${data.company_name ?? 'N/A'}\nResearched: ${data.researched_at ?? 'N/A'}\n\n--- Wikipedia Summary ---\n${data.wiki_summary ?? 'No Wikipedia page found'}\nSource: ${data.wiki_url ?? 'N/A'}\n\n--- Web Search ---\n${data.search_abstract ?? 'No web summary available'}\nOfficial URL: ${data.official_url ?? 'N/A'}\n\n========================================\n`;\n\nreturn {\n  json: {\n    ...data,\n    formatted_report: report.trim()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        16
      ],
      "id": "b2b8042b-6c37-4412-ae05-1a9830f2a578",
      "name": "Format Text Report"
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { company_name: 'College of the Desert' } },\n  { json: { company_name: 'Google' } },\n  { json: { company_name: 'Tesla' } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        16
      ],
      "id": "299af581-06b5-42a7-85c5-300dc61ab674",
      "name": "Company List"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "reports",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1184,
        16
      ],
      "id": "d4c46fe0-4444-433d-bf52-eb2f30fd031e",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const reports = $input.first().json.reports;\nconst summary = reports.map(r =>\n  `• ${r.company_name}: ${r.wiki_summary?.substring(0, 100)}...`\n).join('\\n');\n\nreturn [{\n  json: {\n    report_title: 'Lead Research Batch Report',\n    generated_at: new Date().toISOString(),\n    total_companies: reports.length,\n    summary: summary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
