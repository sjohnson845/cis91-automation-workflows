      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "https://icanhazdadjoke.com/",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "d5736f0a-e5d5-46dd-a275-fcd13e2a4b98",
      "name": "Get Joke"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f78cb11f-c5b4-496d-b62f-c0b1681a20a4",
              "name": "joke",
              "value": "={{ $json.joke }}",
              "type": "string"
            },
            {
              "id": "052bece7-fce4-435a-974c-5cdd42b4e3a7",
              "name": "joke_id",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "b392a0b9-e59b-4eb9-9803-c284ba3add8f",
              "name": "fetched_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
