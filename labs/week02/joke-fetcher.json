            },
            {
              "id": "7968a9a5-544e-4cde-8797-f18ff88b6d15",
              "name": "status",
              "value": "={{ $json.status === 200 ? 'Success' : 'Error' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
        0
      ],
      "id": "2e09ed18-7b28-4dfd-a635-ba2a5992e771",
